# =============================================================================
# BUILD MATERIAL — backend environment
# Copy to `.env` and fill in. Every variable here is read by the code
# (src/config/env.config.js); nothing else is used. Leave secrets empty in
# this file — never commit real values.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# `production` turns on secure cookies, disables the manual test payment and
# the dev payout adapter.
NODE_ENV=development
PORT=5200
# true = return internal error messages in API responses (development only).
SHOW_ERROR_DETAILS=false

# ---------------------------------------------------------------------------
# Database (MongoDB) — the app connects to MONGODB_URL + MONGODB_NAME
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://127.0.0.1:27017/
MONGODB_NAME=material_marketplace

# ---------------------------------------------------------------------------
# URLs & CORS (no trailing slashes)
# ---------------------------------------------------------------------------
# Frontend origin — used in email links (password reset, admin invites).
FRONTEND_URL=http://localhost:2000
# Public API origin — used in email verification links.
BACKEND_URL=http://localhost:5200
# Full URL of the "resend verification email" endpoint used by the
# verification email page, e.g. http://localhost:5200/api/v1/resend-verification
BACKEND_URL_RESEND=http://localhost:5200/api/v1/resend-verification
# Public site origin for sitemap.xml <loc> URLs (falls back to FRONTEND_URL).
SITE_URL=
# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:2000

# ---------------------------------------------------------------------------
# Auth & session
# ---------------------------------------------------------------------------
# JWT signing secret — long random string (e.g. `openssl rand -hex 32`).
SECRET_KEY=
# bcrypt cost factor for password hashing.
COST_FACTOR=12
AUTH_COOKIE_NAME=accessToken
ADMIN_AUTH_COOKIE_NAME=adminAccessToken
# lax | strict | none   (`none` requires AUTH_COOKIE_SECURE=true)
AUTH_COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production; set false only for plain-http dev.
AUTH_COOKIE_SECURE=false
# Optional cookie domain (e.g. .your-domain.in) when API and site share a parent domain.
AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Two-factor authentication
# ---------------------------------------------------------------------------
# Name shown in authenticator apps and 2FA emails.
TOTP_ISSUER=BUILD MATERIAL
# REQUIRED in production — the code falls back to a public placeholder when
# these are empty. Use long random strings.
TOTP_SECRET_PEPPER=
PENDING_TOKEN_SECRET=
# Lifetime (seconds) of the pending-login token between password and 2FA step.
PENDING_TOKEN_TTL_S=300

# ---------------------------------------------------------------------------
# Super admin (created on first start if it does not exist)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# ---------------------------------------------------------------------------
# Email (SMTP) — verification, password reset, 2FA codes, notifications
# ---------------------------------------------------------------------------
# SMTP HOST (despite the name), e.g. smtp.gmail.com
SMTP_SERVICE=
# 587 (STARTTLS). The mailer uses secure=false, so implicit-TLS port 465 won't work.
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------------------
# Google Sign-In
# ---------------------------------------------------------------------------
# OAuth 2.0 Client ID (type "Web application") — Google Cloud Console →
# APIs & Services → Credentials. Same value as the frontend's
# REACT_APP_GOOGLE_CLIENT_ID. Add your site origins under "Authorized
# JavaScript origins". Empty = Google login disabled.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Buyer payments (Razorpay)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
# Secret of the Razorpay webhook pointing at
#   POST https://<api-host>/api/v1/payments/webhook/razorpay
# events: payment.captured, payment.failed, refund.processed, refund.failed
#         (+ payout.processed, payout.failed, payout.reversed if RazorpayX
#          payout events use the same webhook).
# Webhooks are rejected while this is empty.
PAYMENT_WEBHOOK_SECRET=
# Dev/QA-only simulated payment button. Always off when NODE_ENV=production.
ENABLE_MANUAL_PAYMENT_TEST=false

# ---------------------------------------------------------------------------
# Seller payouts (RazorpayX) — authenticates with PAYMENT_KEY_ID / _SECRET
# ---------------------------------------------------------------------------
PAYOUT_PROVIDER=razorpayx
# RazorpayX business (current) account number payouts are debited from.
PAYOUT_ACCOUNT_NUMBER=
# Optional: secret of a SEPARATE RazorpayX webhook for payout.* events.
PAYOUT_WEBHOOK_SECRET=
# Gateway fee (%) shown as its own line in the seller payout breakdown.
PAYMENT_PROCESSING_FEE_PCT=0

# ---------------------------------------------------------------------------
# Marketplace rules
# ---------------------------------------------------------------------------
# DEFAULT commission (%) — only used for a seller type until an admin saves a
# rate in Admin → Commission Settings. Locked onto each transaction at payment.
MARKETPLACE_COMMISSION_PCT=8.9
# Hours inventory stays reserved on an accepted offer before release.
RESERVATION_EXPIRY_HOURS=48
# Accepted deals at/above this amount (₹) raise an admin notification.
ADMIN_HIGH_VALUE_DEAL_INR=500000

# ---------------------------------------------------------------------------
# Push notifications (Firebase Admin SDK) — empty = push disabled,
# in-app notifications still work. From a Firebase service-account JSON.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes, wrapped in quotes: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Redis read cache (optional) — empty = disabled, reads go to MongoDB
# ---------------------------------------------------------------------------
# e.g. redis://localhost:6379
REDIS_URL=
REDIS_KEY_PREFIX=bm:

# ---------------------------------------------------------------------------
# Housekeeping (all optional — defaults shown)
# ---------------------------------------------------------------------------
# Delete un-attached temp uploads older than this many hours.
TEMP_UPLOAD_MAX_AGE_HOURS=24
# Admin audit-log CSV exports.
AUDIT_EXPORT_DIR=storage/auditLogExports
AUDIT_EXPORT_BATCH_SIZE=2000
AUDIT_EXPORT_MAX_CONCURRENT_JOBS=1
AUDIT_EXPORT_FILE_RETENTION_HOURS=48
AUDIT_EXPORT_ACTOR_PRELOAD_MAX=200000
# Optional in-process sweep (ms) deleting expired export files; empty = off.
AUDIT_EXPORT_CLEANUP_INTERVAL_MS=
