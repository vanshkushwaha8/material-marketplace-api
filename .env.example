# ==========================================
# Application
# ==========================================
APPLICATION_NAME=YourAppName
PORT=8000
NODE_ENV=development

# ==========================================
# MongoDB
# ==========================================
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_NAME=your_database_name

# ==========================================
# Authentication
# ==========================================
SECRET_KEY=your_jwt_secret_key

# ==========================================
# Frontend & Backend
# ==========================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000/api/v1/emailVerification/

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==========================================
# Sumsub KYC
# ==========================================
SUMSUB_ENABLED=false
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=
# SUMSUB_LEVEL_NAME=id-and-liveness
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_LEVEL_SEC=sec-kyc-level
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_ASIC=asic-kyc-level
SUMSUB_LEVEL_AMF=amf-kyc-level
 
# ==========================================
# SMTP / Email
# ==========================================
SMTP_SERVICE=
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ==========================================
# Two-Factor Authentication
# ==========================================
TOTP_ISSUER=YourApp
TOTP_SECRET_PEPPER=

# ==========================================
# Pending Token
# ==========================================
PENDING_TOKEN_SECRET=
PENDING_TOKEN_TTL_S=600

# ==========================================
# Twilio
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ===========================KYC=================
KYC_SUPPORTED_COUNTRIES=FR,LT
KYC_KNOWLEDGE_TEST_PASS_THRESHOLD=70
KYC_KNOWLEDGE_TEST_VALIDITY_MONTHS=24

KYC_KNOWLEDGE_TEST_QUESTION_COUNT=5
KYC_QUESTION_BANK_VERSION=v1
# How many months a loss-bearing simulation stays valid (Art 21(6)).
KYC_LOSS_SIM_VALIDITY_MONTHS=12
# How many months an approved sophisticated-investor status stays valid.
KYC_SOPHISTICATION_VALIDITY_MONTHS=24
# Max upload size (MB) accepted for KYC documents.
KYC_DOCUMENT_MAX_SIZE_MB=15

# ==========================================
# Default Admin
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin


# ─────────────────────────────────────────────
# E15 — Money Operations & Financial Crime
# ─────────────────────────────────────────────

# ── PSP Integration (OPL-401, OPL-402)
# Provider: "lemonway" | "mangopay" | null
# Set PSP_ENABLED=false to use manual payment instruction fallback.
PSP_ENABLED=false
PSP_PROVIDER=
PSP_API_URL=
PSP_API_KEY=
PSP_WEBHOOK_SECRET=
PSP_CLIENT_ID=
# Lemonway-specific
PSP_LEMONWAY_VERSION=
# Mangopay-specific
PSP_MANGOPAY_CLIENT_ID=

# ── Sanctions Screening (OPL-404)
# Provider: "complyadvantage" | "refinitiv" | null
# Set SANCTIONS_ENABLED=false to use manual review fallback.
SANCTIONS_ENABLED=false
SANCTIONS_PROVIDER=
SANCTIONS_API_URL=
SANCTIONS_API_KEY=

# ── AML Rule Engine thresholds (OPL-404)
# These are internal config — no third party required.
AML_HIGH_VALUE_THRESHOLD_MINOR_UNITS=1000000
AML_VELOCITY_WINDOW_HOURS=24
AML_VELOCITY_MAX_TRANSACTIONS=10
AML_HIGH_RISK_JURISDICTIONS=IR,KP,SY,CU,VE,MM

# ── Reconciliation SLA (OPL-403)
RECON_EXCEPTION_SLA_HOURS=48

# ── Dual Control SLA (OPL-401)
WITHDRAWAL_HOLD_SLA_HOURS=24


PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_ACCOUNT_ID=
PAYMENT_MODE=test

# Platform commission, applied to every completed transaction (see
# transaction.service.js#calculateCommissionRupees). Includes GST +
# platform fee as one configured deduction per current business rule.
MARKETPLACE_COMMISSION_PCT=8.9

# How long inventory stays reserved on an accepted offer before release.
RESERVATION_EXPIRY_HOURS=48